# Copy to .env and replace before shared or production use.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ALLOWED_ORIGINS=http://localhost:4301,http://localhost:4302,http://localhost:4303
# Production first-admin creation additionally requires x-bootstrap-secret.
BOOTSTRAP_SECRET=replace-with-another-random-secret
# Frontend build API origin. Widget instances use the api attribute.
VITE_API_URL=http://localhost:4300
# Generic website-side installer (4304, proxied by the website at /host-api).
HOST_SITE_URL=http://localhost:4303
HOST_CENTRAL_URL=http://localhost:4300
# Required in production: bcrypt hash of a unique host administrator password.
# HOST_ADMIN_PASSWORD_HASH=
# Optional absolute path outside public web roots:
# HOST_INSTALLATION_FILE=/private/application-data/installation.json

# Production API operations (the local production launcher sets its own values)
# STORE_BACKEND=sqlite
# TRUST_PROXY=loopback
# RETENTION_CONVERSATION_DAYS=90
# RETENTION_AUDIT_DAYS=365
